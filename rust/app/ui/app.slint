// MultiDroid em Slint (docs/spec/MULTIPLATAFORMA.md §2.2), as mesmas telas do
// Mac (MAC.md §2.6): painel à esquerda, mesa em grade de 24 colunas à direita.
// As cores e a forma chegam de docs/design/tokens.json pelo global Tema,
// preenchido em main.rs: nenhum número de design é repetido aqui.

export global Tema {
    in property <color> fundo;
    in property <color> superficie;
    in property <color> borda;
    in property <color> sombra;
    in property <color> tinta;
    in property <color> tinta-sobre-acento;
    in property <color> azul;
    in property <color> verde;
    in property <color> ciano;
    in property <color> amarelo;
    in property <color> vermelho;
    in property <color> rosa;
    in property <color> roxo;
    in property <length> largura-borda;
    in property <length> raio;
    in property <length> sombra-x;
    in property <length> sombra-y;
}

// Estados de um aparelho, como na 0.2.
export enum Estado { desligado, ligando, ligado, pausado, desligando, externo, hibernado }

export struct Aparelho {
    nome: string,
    tipo: string,
    android: string,
    estado: Estado,
    mensagem: string,
    metricas: string,
    grupo: string,
    // lugar na grade livre, em células
    x: int, y: int, w: int, h: int,
    // proporção da tela (largura / altura), já girada
    proporcao: float,
    tela: image,
    tem-tela: bool,
    relogio: bool,
    selecionado: bool,
}

// Um pacote da tela de Imagens (o emulador ou uma imagem de sistema).
export struct Pacote {
    path: string,
    titulo: string,
    detalhe: string,
    nota: string,
    // "Installed · r4", "12 MB", "Downloading 45%", "Extracting…"
    situacao: string,
    instalado: bool,
    atualizar: bool,
    ocupado: bool,
    em-uso: bool,
}

// Uma imagem que serve para o tipo escolhido no Novo aparelho.
export struct Opcao {
    path: string,
    titulo: string,
    detalhe: string,
    nota: string,
    instalada: bool,
}

// Bloco neo-brutalista: borda grossa e sombra dura, sem desfoque.
component Bloco inherits Rectangle {
    in property <color> cor: Tema.superficie;
    in property <bool> sombra: true;
    Rectangle {
        x: Tema.sombra-x; y: Tema.sombra-y;
        width: parent.width; height: parent.height;
        background: sombra ? Tema.sombra : transparent;
        border-radius: Tema.raio;
    }
    Rectangle {
        background: cor; border-radius: Tema.raio;
        border-width: Tema.largura-borda; border-color: Tema.borda;
        @children
    }
}

// Botão com a sombra que some ao apertar (a pressão de 70 ms dos tokens).
component BotaoBase inherits Rectangle {
    in property <string> texto;
    in property <color> cor: Tema.superficie;
    in property <length> tamanho-fonte: 14px;
    in property <bool> ativo: true;
    in property <string> dica;
    // Ícone em SVG no lugar do texto: os símbolos Unicode faltam na fonte do
    // renderizador por software (▢, ⌗, ❚❚ saíam em branco).
    in property <image> icone;
    callback clicou();
    out property <length> largura-texto: t.preferred-width;
    property <bool> mostrar-dica;
    opacity: ativo ? 1 : 0.4;
    accessible-role: button;
    accessible-label: dica != "" ? dica : texto;
    accessible-action-default => { clicou(); }
    Rectangle {
        x: area.pressed ? 0 : Tema.sombra-x * 0.75; y: area.pressed ? 0 : Tema.sombra-y * 0.75;
        width: parent.width; height: parent.height;
        background: Tema.sombra; border-radius: Tema.raio * 0.8;
        animate x, y { duration: 70ms; }
    }
    Rectangle {
        x: area.pressed ? Tema.sombra-x * 0.75 : 0; y: area.pressed ? Tema.sombra-y * 0.75 : 0;
        animate x, y { duration: 70ms; }
        background: cor; border-radius: Tema.raio * 0.8;
        border-width: Tema.largura-borda; border-color: Tema.borda;
        t := Text {
            text: texto; font-size: tamanho-fonte; font-weight: 800;
            color: cor == Tema.superficie ? Tema.tinta : Tema.tinta-sobre-acento;
            horizontal-alignment: center; vertical-alignment: center;
        }
        if icone.width > 0: Image {
            source: icone;
            width: parent.width * 0.6; height: parent.height * 0.6;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            colorize: cor == Tema.superficie ? Tema.tinta : Tema.tinta-sobre-acento;
        }
    }
    area := TouchArea {
        enabled: ativo;
        mouse-cursor: pointer;
        clicked => { mostrar-dica = false; clicou(); }
        changed has-hover => { if !self.has-hover { mostrar-dica = false; } }
    }
    // Dica de botão de ícone: aparece à esquerda depois de meio segundo parado em cima.
    Timer {
        interval: 500ms;
        running: area.has-hover && !mostrar-dica && icone.width > 0 && dica != "";
        triggered => { mostrar-dica = true; }
    }
    if mostrar-dica: Rectangle {
        z: 100;
        width: d.preferred-width + 16px; height: d.preferred-height + 10px;
        x: - self.width - 6px; y: (parent.height - self.height) / 2;
        background: Tema.tinta; border-radius: 6px;
        d := Text {
            text: dica; font-size: 11px; font-weight: 700; color: Tema.fundo;
            x: 8px; y: 5px;
        }
    }
}

component Botao inherits BotaoBase {
    min-width: self.largura-texto + 24px;
    preferred-width: self.largura-texto + 32px;
    // Altura única para todo botão de texto, em qualquer tela.
    min-height: 36px;
    preferred-height: 36px;
    max-height: 36px;
    // Não estica para ocupar a linha; quem quiser esticar passa outro valor.
    horizontal-stretch: 0;
    vertical-stretch: 0;
}

// Botão quadrado de ícone (glifo), para a coluna do quadro e as linhas do painel.
component Icone inherits BotaoBase {
    in property <string> glifo;
    in property <length> lado: 32px;
    texto: glifo;
    width: lado; height: lado;
    tamanho-fonte: 13px;
}

component Ponto inherits Rectangle {
    in property <Estado> estado;
    width: 10px; height: 10px; border-radius: 5px;
    border-width: 1.5px; border-color: Tema.borda;
    background: estado == Estado.ligado ? Tema.verde
        : estado == Estado.pausado ? Tema.azul
        : estado == Estado.hibernado ? Tema.ciano
        : estado == Estado.ligando || estado == Estado.desligando ? Tema.amarelo
        : estado == Estado.externo ? Tema.roxo
        : transparent;
}

export global Rotulo {
    pure public function de(e: Estado) -> string {
        if e == Estado.ligado { return @tr("on"); }
        if e == Estado.pausado { return @tr("paused"); }
        if e == Estado.hibernado { return @tr("hibernating"); }
        if e == Estado.ligando { return @tr("starting…"); }
        if e == Estado.desligando { return @tr("shutting down…"); }
        if e == Estado.externo { return @tr("opened outside MultiDroid"); }
        return @tr("off");
    }
}

component LinhaAparelho inherits Bloco {
    in property <Aparelho> a;
    callback acao(string);
    height: 74px;
    HorizontalLayout {
        padding: 10px; spacing: 10px;
        sel := Rectangle {
            width: 34px; height: 46px;
            Bloco {
                sombra: false;
                cor: a.selecionado ? Tema.amarelo : (a.relogio ? Tema.roxo : Tema.azul);
                if a.selecionado: Image {
                    source: @image-url("../icons/ui/marcar.svg");
                    width: 22px; height: 22px;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    colorize: Tema.tinta-sobre-acento;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { acao("selecionar"); }
            }
        }
        VerticalLayout {
            spacing: 2px; alignment: center;
            Text { text: a.nome; font-size: 15px; font-weight: 900; color: Tema.tinta; overflow: elide; }
            HorizontalLayout {
                spacing: 6px; alignment: start;
                Ponto { estado: a.estado; y: (parent.height - self.height) / 2; }
                Text { text: a.mensagem != "" ? a.mensagem : Rotulo.de(a.estado); font-size: 12px; font-weight: 700; color: Tema.tinta; overflow: elide; }
            }
            Text {
                text: a.metricas != "" ? a.metricas : a.tipo + " · " + a.android;
                font-size: 11px; color: Tema.tinta; opacity: 0.6; overflow: elide;
            }
        }
        HorizontalLayout {
            spacing: 6px; alignment: end;
            VerticalLayout { alignment: center;
                HorizontalLayout { spacing: 6px;
                    if a.estado == Estado.desligado || a.estado == Estado.hibernado: Icone { icone: @image-url("../icons/ui/retomar.svg"); cor: Tema.verde; dica: @tr("Start"); clicou => { acao("ligar"); } }
                    if a.estado == Estado.ligado: Icone { icone: @image-url("../icons/ui/pausar.svg"); cor: Tema.azul; dica: @tr("Pause"); clicou => { acao("pausar"); } }
                    if a.estado == Estado.pausado: Icone { icone: @image-url("../icons/ui/retomar.svg"); cor: Tema.verde; dica: @tr("Resume"); clicou => { acao("retomar"); } }
                    if a.estado == Estado.ligado || a.estado == Estado.pausado: Icone { icone: @image-url("../icons/ui/hibernar.svg"); cor: Tema.ciano; dica: @tr("Hibernate"); clicou => { acao("hibernar"); } }
                    if a.estado != Estado.desligado && a.estado != Estado.desligando: Icone { icone: @image-url("../icons/ui/desligar.svg"); cor: Tema.vermelho; dica: @tr("Shut down"); clicou => { acao("desligar"); } }
                    Icone { icone: @image-url("../icons/ui/mais.svg"); dica: @tr("More: duplicate, group, delete"); clicou => { acao("menu"); } }
                }
            }
        }
    }
}

// Botões de navegação do aparelho, na ordem da 0.2.
component BotoesNavegacao inherits VerticalLayout {
    in property <Aparelho> a;
    in property <bool> vivo;
    in property <length> lado: 32px;
    callback acao(string);
    spacing: 5px; alignment: start;
    Icone { lado: root.lado; icone: @image-url("../icons/ui/voltar.svg"); dica: @tr("Back"); ativo: vivo; clicou => { acao("voltar"); } }
    Icone { lado: root.lado; icone: @image-url("../icons/ui/inicio.svg"); dica: @tr("Home"); ativo: vivo; clicou => { acao("inicio"); } }
    Icone { lado: root.lado; icone: @image-url("../icons/ui/recentes.svg"); dica: @tr("Recents"); ativo: vivo; clicou => { acao("recentes"); } }
    Icone { lado: root.lado; icone: @image-url("../icons/ui/volume-mais.svg"); dica: @tr("Volume +"); ativo: vivo; clicou => { acao("volume+"); } }
    Icone { lado: root.lado; icone: @image-url("../icons/ui/volume-menos.svg"); dica: @tr("Volume −"); ativo: vivo; clicou => { acao("volume-"); } }
    if !a.relogio: Icone { lado: root.lado; icone: @image-url("../icons/ui/girar.svg"); dica: @tr("Rotate"); ativo: vivo; clicou => { acao("girar"); } }
    Icone { lado: root.lado; icone: @image-url("../icons/ui/captura.svg"); dica: @tr("Screenshot"); ativo: vivo; clicou => { acao("captura"); } }
}

// Pausar ou retomar, hibernar e desligar.
component BotoesEstado inherits VerticalLayout {
    in property <Aparelho> a;
    in property <length> lado: 32px;
    callback acao(string);
    spacing: 5px; alignment: start;
    if a.estado == Estado.ligado: Icone { lado: root.lado; icone: @image-url("../icons/ui/pausar.svg"); cor: Tema.azul; dica: @tr("Pause"); clicou => { acao("pausar"); } }
    if a.estado == Estado.pausado: Icone { lado: root.lado; icone: @image-url("../icons/ui/retomar.svg"); cor: Tema.verde; dica: @tr("Resume"); clicou => { acao("retomar"); } }
    Icone { lado: root.lado; icone: @image-url("../icons/ui/hibernar.svg"); cor: Tema.ciano; dica: @tr("Hibernate: frees the memory and keeps the state"); clicou => { acao("hibernar"); } }
    Icone { lado: root.lado; icone: @image-url("../icons/ui/desligar.svg"); cor: Tema.vermelho; dica: @tr("Shut down"); clicou => { acao("desligar"); } }
}

// Um quadro da mesa: cabeçalho, a tela do Android e a coluna de botões.
component Quadro inherits Bloco {
    in property <Aparelho> a;
    in property <length> celula;
    // Deslocamento e aumento enquanto arrasta, em pixels; viram células ao soltar.
    in-out property <length> desloc-x;
    in-out property <length> desloc-y;
    in-out property <length> extra-w;
    in-out property <length> extra-h;
    callback mover(int, int);
    callback redimensionar(int, int);
    callback acao(string);
    callback toque(float, float, string);
    callback tecla(string);
    property <bool> vivo: a.estado == Estado.ligado;
    property <bool> com-botoes: a.estado == Estado.ligado || a.estado == Estado.pausado;
    // Altura da coluna única: botões de 32 px com 5 px entre eles, o respiro de
    // 4 px, mais cabeçalho (22), margens (16) e espaço (6).
    property <int> n-botoes: a.relogio ? 9 : 10;
    property <bool> duas-colunas: root.height < n-botoes * 37px + 4px + 44px;
    // Em duas colunas, a da navegação é a mais alta (6 ou 7 botões); se nem
    // assim cabe, os botões encolhem até 16 px em vez de vazar do quadro.
    property <int> n-nav: a.relogio ? 6 : 7;
    property <length> lado-botao: duas-colunas
        ? max(16px, min(32px, (root.height - 44px - (n-nav - 1) * 5px) / n-nav))
        : 32px;

    VerticalLayout {
        padding: 8px; spacing: 6px;
        cabecalho := Rectangle {
            height: 22px;
            HorizontalLayout {
                spacing: 6px;
                Ponto { estado: a.estado; y: (parent.height - self.height) / 2; }
                Text { text: a.nome; font-size: 13px; font-weight: 900; color: Tema.tinta; vertical-alignment: center; overflow: elide; }
                Text { text: a.mensagem; font-size: 11px; color: Tema.tinta; opacity: 0.6; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
            }
            // Arrastar pelo título muda o lugar na grade.
            // Só conta o arrasto que começou com o botão descendo aqui.
            TouchArea {
                property <bool> arrastando;
                mouse-cursor: move;
                moved => {
                    if arrastando && self.pressed {
                        root.desloc-x += self.mouse-x - self.pressed-x;
                        root.desloc-y += self.mouse-y - self.pressed-y;
                    }
                }
                pointer-event(e) => {
                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                        arrastando = true;
                        root.desloc-x = 0; root.desloc-y = 0;
                    }
                    if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                        if arrastando && e.kind == PointerEventKind.up {
                            root.mover(round(root.desloc-x / root.celula), round(root.desloc-y / root.celula));
                        }
                        arrastando = false;
                        root.desloc-x = 0; root.desloc-y = 0;
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            area := Rectangle {
                // A tela ocupa o maior retângulo com a proporção do aparelho.
                property <length> lw: min(self.width, self.height * a.proporcao);
                property <length> lh: lw / a.proporcao;
                tela := Rectangle {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: lw; height: lh;
                    background: #000;
                    border-radius: a.relogio ? lw / 2 : 6px;
                    clip: true;
                    if a.tem-tela: Image {
                        width: parent.width; height: parent.height;
                        source: a.tela; image-fit: fill;
                        opacity: a.estado == Estado.ligado ? 1 : 0.45;
                    }
                    // O renderizador por software não recorta com border-radius:
                    // os cantos do relógio são cobertos na cor do quadro.
                    if a.relogio: Image {
                        width: parent.width; height: parent.height;
                        source: @image-url("../icons/ui/mascara-redonda.svg"); image-fit: fill;
                        colorize: root.cor;
                    }
                    teclado := FocusScope {
                        enabled: vivo;
                        key-pressed(e) => {
                            if e.modifiers.control || e.modifiers.meta { return reject; }
                            tecla(e.text);
                            accept
                        }
                        TouchArea {
                            enabled: vivo;
                            pointer-event(e) => {
                                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                    teclado.focus();
                                    toque(self.mouse-x / self.width, self.mouse-y / self.height, "down");
                                }
                                if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                                    toque(self.mouse-x / self.width, self.mouse-y / self.height, "up");
                                }
                            }
                            moved => {
                                if self.pressed { toque(self.mouse-x / self.width, self.mouse-y / self.height, "move"); }
                            }
                        }
                    }
                }
                if a.estado == Estado.desligado || a.estado == Estado.hibernado: VerticalLayout {
                    alignment: center;
                    HorizontalLayout { alignment: center;
                        Botao {
                            texto: a.estado == Estado.hibernado ? @tr("Wake") : @tr("Start");
                            cor: a.estado == Estado.hibernado ? Tema.ciano : Tema.verde;
                            clicou => { acao("ligar"); }
                        }
                    }
                }
                if a.estado == Estado.pausado: VerticalLayout {
                    alignment: center;
                    HorizontalLayout { alignment: center;
                        Botao { texto: @tr("Resume"); cor: Tema.verde; clicou => { acao("retomar"); } }
                    }
                }
            }
            // Uma coluna quando cabe; num quadro baixo (o relógio em 6×6, por
            // exemplo) os botões vão para duas colunas, senão a coluna empurra o
            // layout para fora do quadro e a tela vaza junto.
            if com-botoes && !duas-colunas: VerticalLayout {
                width: 32px; spacing: 5px; alignment: start;
                BotoesNavegacao { a: a; vivo: vivo; acao(n) => { acao(n); } }
                Rectangle { height: 4px; }
                BotoesEstado { a: a; acao(n) => { acao(n); } }
            }
            if com-botoes && duas-colunas: HorizontalLayout {
                width: 2 * lado-botao + 5px; spacing: 5px;
                BotoesNavegacao { a: a; vivo: vivo; lado: lado-botao; acao(n) => { acao(n); } }
                BotoesEstado { a: a; lado: lado-botao; acao(n) => { acao(n); } }
            }
        }
    }
    // O canto inferior direito muda o tamanho, em células.
    Rectangle {
        x: parent.width - 18px; y: parent.height - 18px;
        width: 16px; height: 16px;
        Image { source: @image-url("../icons/ui/redimensionar.svg"); width: 14px; height: 14px; x: 1px; y: 1px; colorize: Tema.tinta; opacity: 0.5; }
        TouchArea {
            property <bool> puxando;
            mouse-cursor: nwse-resize;
            moved => {
                if puxando && self.pressed {
                    root.extra-w += self.mouse-x - self.pressed-x;
                    root.extra-h += self.mouse-y - self.pressed-y;
                }
            }
            pointer-event(e) => {
                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                    puxando = true;
                    root.extra-w = 0; root.extra-h = 0;
                }
                if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                    if puxando && e.kind == PointerEventKind.up {
                        root.redimensionar(round(root.extra-w / root.celula), round(root.extra-h / root.celula));
                    }
                    puxando = false;
                    root.extra-w = 0; root.extra-h = 0;
                }
            }
        }
    }
}

// Campo de texto no estilo da casa.
component Campo inherits Bloco {
    in property <string> dica;
    in-out property <string> texto <=> entrada.text;
    sombra: false;
    height: 40px;
    entrada := TextInput {
        x: 12px; width: parent.width - 24px; height: parent.height;
        vertical-alignment: center; font-size: 14px; color: Tema.tinta;
        single-line: true;
    }
    if entrada.text == "": Text {
        x: 12px; height: parent.height; text: dica; font-size: 14px; color: Tema.tinta; opacity: 0.45;
        vertical-alignment: center;
    }
}

// Fundo escuro e uma caixa por cima: as telas de Imagens, Licença, Novo aparelho.
component Sobreposta inherits Rectangle {
    in property <length> largura: 640px;
    in property <length> altura: 560px;
    callback fechar();
    background: #000000a0;
    TouchArea { clicked => { fechar(); } }
    Bloco {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: min(largura, parent.width - 32px); height: min(altura, parent.height - 32px);
        TouchArea {}
        @children
    }
}

component CartaoPacote inherits Bloco {
    in property <Pacote> p;
    callback pacote(string);
    height: p.nota != "" ? 96px : 74px;
    HorizontalLayout {
        padding: 12px; spacing: 10px;
        VerticalLayout {
            spacing: 2px; alignment: center;
            Text { text: p.titulo; font-size: 14px; font-weight: 900; color: Tema.tinta; overflow: elide; }
            Text { text: p.detalhe; font-size: 11px; color: Tema.tinta; opacity: 0.6; overflow: elide; }
            Text { text: p.situacao; font-size: 11px; font-weight: 700; color: Tema.tinta; overflow: elide; }
            if p.nota != "": Text { text: p.nota; font-size: 11px; color: Tema.tinta; opacity: 0.75; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center; spacing: 6px;
            if p.ocupado: Botao { texto: @tr("Cancel"); clicou => { pacote("cancelar"); } }
            if !p.ocupado && !p.instalado: Botao { texto: @tr("Download"); cor: Tema.azul; clicou => { pacote("baixar"); } }
            if !p.ocupado && p.atualizar: Botao { texto: @tr("Update"); cor: Tema.azul; ativo: !p.em-uso; dica: p.em-uso ? @tr("Shut down the devices that use this image") : @tr("Update"); clicou => { pacote("baixar"); } }
            if !p.ocupado && p.instalado && !p.atualizar: Botao { texto: @tr("Remove"); ativo: !p.em-uso; dica: p.em-uso ? @tr("Shut down the devices that use this image") : @tr("Remove"); clicou => { pacote("remover"); } }
        }
    }
}

component CartaoOpcao inherits Bloco {
    in property <Opcao> o;
    in property <bool> escolhida;
    callback escolher();
    cor: escolhida ? Tema.azul : Tema.superficie;
    height: 58px;
    VerticalLayout {
        padding-left: 12px; padding-right: 12px; alignment: center; spacing: 2px;
        Text { text: o.instalada ? o.titulo : @tr("{} · download", o.titulo); font-size: 13px; font-weight: 900; color: escolhida ? Tema.tinta-sobre-acento : Tema.tinta; overflow: elide; }
        Text { text: o.detalhe; font-size: 11px; color: escolhida ? Tema.tinta-sobre-acento : Tema.tinta; opacity: 0.7; overflow: elide; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { escolher(); } }
}

export component AppWindow inherits Window {
    title: "MultiDroid Preview";
    icon: @image-url("../icons/256x256.png");
    preferred-width: 1400px;
    preferred-height: 860px;
    min-width: 900px;
    min-height: 560px;
    background: Tema.fundo;
    in property <string> versao;
    in property <[Aparelho]> aparelhos;
    in property <string> memoria;
    in property <float> teto;
    in property <string> aviso;
    in property <bool> sem-emulador;
    in property <int> selecionados;
    // linhas ocupadas na grade (o maior y + h)
    in property <int> linhas;
    // "", "imagens", "licenca", "novo", "menu", "apagar", "grupo"
    in-out property <string> tela;
    in-out property <string> alvo;
    in property <[Pacote]> pacotes;
    in property <string> imagens-erro;
    in property <bool> imagens-carregando;
    in property <string> licenca-titulo;
    in property <string> licenca-texto;
    in property <[Opcao]> opcoes;
    in-out property <int> novo-tipo;
    // 0 = completo (emulador), 1 = leve (Redroid, só no Linux)
    in-out property <int> novo-motor;
    in property <bool> tem-leve;
    in-out property <string> novo-imagem;
    in property <string> novo-erro;
    in property <string> novo-nota;
    in property <bool> novo-ocupado;
    callback acao(string, string);
    callback lote(string);
    callback toque(string, float, float, string);
    callback tecla(string, string);
    callback mover(string, int, int);
    callback redimensionar(string, int, int);
    callback organizar(int);
    callback teto-mudou(int);
    callback abrir-imagens();
    callback pacote(string, string);
    callback licenca(bool);
    callback abrir-novo();
    callback novo-tipo-mudou(int);
    callback criar(int, int, string, string, string);
    callback grupo(string, string);
    callback apagar(string);

    HorizontalLayout {
        padding: 16px; spacing: 16px;
        VerticalLayout {
            width: 330px; spacing: 12px; alignment: start;
            HorizontalLayout {
                spacing: 10px;
                Text { text: "MultiDroid"; font-size: 26px; font-weight: 900; color: Tema.tinta; vertical-alignment: center; }
                Text { text: @tr("Preview {}", versao); font-size: 12px; font-weight: 700; color: Tema.tinta; opacity: 0.6; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: 10px;
                Botao { texto: @tr("+ New device"); cor: Tema.azul; clicou => { abrir-novo(); } }
                Botao { texto: @tr("Images"); clicou => { abrir-imagens(); } }
            }
            if memoria != "": Bloco {
                height: 96px;
                VerticalLayout {
                    padding: 12px; spacing: 8px;
                    Text { text: memoria; font-size: 12px; font-weight: 700; color: Tema.tinta; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: @tr("Memory ceiling"); font-size: 12px; font-weight: 800; color: Tema.tinta; vertical-alignment: center; }
                        Icone { icone: @image-url("../icons/ui/volume-menos.svg"); dica: @tr("Lower the ceiling"); ativo: teto > 4; clicou => { teto-mudou(-1); } }
                        Text { text: round(teto) + " GB"; font-size: 14px; font-weight: 900; color: Tema.tinta; vertical-alignment: center; min-width: 48px; horizontal-alignment: center; }
                        Icone { icone: @image-url("../icons/ui/volume-mais.svg"); dica: @tr("Raise the ceiling"); clicou => { teto-mudou(1); } }
                    }
                }
            }
            if sem-emulador: Bloco {
                cor: Tema.amarelo; height: 56px;
                HorizontalLayout {
                    padding: 10px; spacing: 8px;
                    Text { text: @tr("The emulator is needed to start devices."); font-size: 12px; font-weight: 700; color: Tema.tinta-sobre-acento; wrap: word-wrap; vertical-alignment: center; }
                    Botao { texto: @tr("Open Images"); cor: Tema.superficie; clicou => { abrir-imagens(); } }
                }
            }
            if selecionados > 0: Bloco {
                cor: Tema.amarelo; height: 92px;
                VerticalLayout {
                    padding: 10px; spacing: 8px;
                    HorizontalLayout {
                        Text { text: @tr("{} selected", selecionados); font-size: 12px; font-weight: 900; color: Tema.tinta-sobre-acento; vertical-alignment: center; }
                        Botao { texto: @tr("Clear"); cor: Tema.superficie; tamanho-fonte: 12px; clicou => { lote("limpar"); } }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Botao { texto: @tr("Start"); cor: Tema.verde; tamanho-fonte: 12px; clicou => { lote("ligar"); } }
                        Botao { texto: @tr("Pause"); cor: Tema.azul; tamanho-fonte: 12px; clicou => { lote("pausar"); } }
                        Botao { texto: @tr("Hibernate"); cor: Tema.ciano; tamanho-fonte: 12px; clicou => { lote("hibernar"); } }
                        Botao { texto: @tr("Shut down"); cor: Tema.vermelho; tamanho-fonte: 12px; clicou => { lote("desligar"); } }
                    }
                }
            }
            Flickable {
                content-height: lista.preferred-height;
                lista := VerticalLayout {
                    spacing: 12px; alignment: start;
                    padding-right: Tema.sombra-x; padding-bottom: Tema.sombra-y;
                    for a in aparelhos: LinhaAparelho {
                        a: a;
                        acao(o) => {
                            if o == "menu" { root.alvo = a.nome; root.tela = "menu"; }
                            else { root.acao(a.nome, o); }
                        }
                    }
                }
            }
            if aparelhos.length == 0: Text {
                text: @tr("No devices yet. Create the first one with + New device.");
                font-size: 13px; color: Tema.tinta; opacity: 0.6; wrap: word-wrap;
            }
            if aviso != "": Bloco {
                cor: Tema.amarelo; height: 56px;
                Text {
                    x: 12px; width: parent.width - 24px; height: parent.height;
                    text: aviso; font-size: 12px; font-weight: 700; color: Tema.tinta-sobre-acento; wrap: word-wrap; vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
        spacing: 8px;
        if aparelhos.length > 0: HorizontalLayout {
            spacing: 10px; height: 36px;
            Text { text: @tr("Drag by the title · resize from the corner"); font-size: 11px; font-weight: 700; color: Tema.tinta; opacity: 0.6; vertical-alignment: center; overflow: elide; }
            // Encaixa todos os quadros da mesa na altura visível da janela.
            Icone {
                icone: @image-url("../icons/ui/organizar.svg");
                dica: @tr("Arrange: fit every device in the window");
                y: (parent.height - self.height) / 2;
                clicou => { root.organizar(floor(mesa.height / mesa.celula)); }
            }
        }
        mesa := Flickable {
            // Grade livre: 24 colunas de células quadradas que acompanham a janela;
            // rola na vertical quando os quadros passam da altura.
            property <length> celula: self.width / 24;
            content-width: self.width;
            content-height: max(self.height, linhas * celula + 20px);
            for a in aparelhos: Quadro {
                x: a.x * mesa.celula + self.desloc-x;
                y: a.y * mesa.celula + self.desloc-y;
                width: max(4 * mesa.celula, a.w * mesa.celula + self.extra-w) - 10px;
                height: max(5 * mesa.celula, a.h * mesa.celula + self.extra-h) - 10px;
                z: self.desloc-x != 0 || self.desloc-y != 0 || self.extra-w != 0 || self.extra-h != 0 ? 10 : 0;
                celula: mesa.celula;
                a: a;
                acao(o) => { root.acao(a.nome, o); }
                toque(fx, fy, k) => { root.toque(a.nome, fx, fy, k); }
                tecla(t) => { root.tecla(a.nome, t); }
                mover(dx, dy) => { root.mover(a.nome, dx, dy); }
                redimensionar(dw, dh) => { root.redimensionar(a.nome, dw, dh); }
            }
            if aparelhos.length == 0: VerticalLayout {
                alignment: center;
                Text { text: @tr("The desk is empty."); font-size: 18px; font-weight: 900; color: Tema.tinta; horizontal-alignment: center; }
                Text { text: sem-emulador ? @tr("Download the emulator in Images, then create a device.") : @tr("Create a device with + New device."); font-size: 13px; color: Tema.tinta; opacity: 0.6; horizontal-alignment: center; }
            }
        }
        }
    }

    if tela == "imagens": Sobreposta {
        largura: 720px; altura: 640px;
        fechar => { root.tela = ""; }
        VerticalLayout {
            padding: 20px; spacing: 12px; alignment: start;
            HorizontalLayout {
                Text { text: @tr("Images"); font-size: 22px; font-weight: 900; color: Tema.tinta; vertical-alignment: center; }
                Botao { texto: @tr("Close"); clicou => { root.tela = ""; } }
            }
            Text {
                text: imagens-carregando ? @tr("Reading the official repository…") : @tr("The emulator and system images come from the official Android repository, checked by SHA-1. Each image has its own license, which you accept before downloading.");
                font-size: 12px; color: Tema.tinta; opacity: 0.7; wrap: word-wrap;
            }
            if imagens-erro != "": Text { text: imagens-erro; font-size: 12px; font-weight: 700; color: Tema.vermelho; wrap: word-wrap; }
            Flickable {
                content-height: pl.preferred-height;
                pl := VerticalLayout {
                    spacing: 10px; padding-right: Tema.sombra-x; padding-bottom: Tema.sombra-y;
                    for p in pacotes: CartaoPacote { p: p; pacote(a) => { root.pacote(p.path, a); } }
                }
            }
        }
    }

    if tela == "licenca": Sobreposta {
        largura: 720px; altura: 640px;
        fechar => { root.licenca(false); }
        VerticalLayout {
            padding: 20px; spacing: 12px; alignment: start;
            Text { text: @tr("License: {}", licenca-titulo); font-size: 18px; font-weight: 900; color: Tema.tinta; wrap: word-wrap; }
            Text { text: @tr("To download, accept the package license. The acceptance is recorded the same way sdkmanager records it."); font-size: 12px; color: Tema.tinta; opacity: 0.7; wrap: word-wrap; }
            Bloco {
                sombra: false;
                Flickable {
                    x: 12px; width: parent.width - 24px;
                    content-height: lt.preferred-height;
                    lt := Text { width: parent.width; text: licenca-texto; font-size: 11px; color: Tema.tinta; wrap: word-wrap; }
                }
            }
            HorizontalLayout {
                spacing: 10px; alignment: end;
                Botao { texto: @tr("Decline"); clicou => { root.licenca(false); } }
                Botao { texto: @tr("Accept and download"); cor: Tema.azul; clicou => { root.licenca(true); } }
            }
        }
    }

    if tela == "novo": Sobreposta {
        largura: 620px; altura: 680px;
        fechar => { root.tela = ""; }
        property <[string]> tipos: [@tr("Phone"), @tr("Tablet"), @tr("Foldable"), @tr("Watch")];
        VerticalLayout {
            padding: 20px; spacing: 12px; alignment: start;
            Text { text: @tr("New device"); font-size: 22px; font-weight: 900; color: Tema.tinta; }
            if tem-leve: HorizontalLayout {
                spacing: 10px;
                Botao {
                    horizontal-stretch: 1; texto: @tr("Light (Redroid)"); cor: novo-motor == 1 ? Tema.azul : Tema.superficie;
                    clicou => { root.novo-motor = 1; }
                }
                Botao {
                    horizontal-stretch: 1; texto: @tr("Full (emulator)"); cor: novo-motor == 0 ? Tema.azul : Tema.superficie;
                    clicou => { root.novo-motor = 0; }
                }
            }
            if tem-leve && novo-motor == 1: Text {
                text: @tr("Android 13 in a container, straight on Linux: ~1.2 GB per device, against ~4.5 GB for the emulator. Needs Docker and binder in the kernel. Hibernating shuts it down and keeps apps and accounts on disk.");
                font-size: 12px; color: Tema.tinta; opacity: 0.75; wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 10px;
                for t[i] in tipos: Botao {
                    horizontal-stretch: 1;
                    texto: t; cor: novo-tipo == i ? Tema.azul : Tema.superficie;
                    clicou => { root.novo-tipo = i; root.novo-tipo-mudou(i); }
                }
            }
            if novo-motor == 0 && opcoes.length == 0: Text {
                text: imagens-carregando ? @tr("Looking for images in the repository…") : (imagens-erro != "" ? imagens-erro : @tr("No image for this type."));
                font-size: 12px; font-weight: 700; color: Tema.tinta; wrap: word-wrap;
            }
            if novo-motor == 0: Flickable {
                height: 230px;
                content-height: ol.preferred-height;
                ol := VerticalLayout {
                    spacing: 8px; padding-right: Tema.sombra-x; padding-bottom: Tema.sombra-y;
                    for o in opcoes: CartaoOpcao {
                        o: o; escolhida: o.path == root.novo-imagem;
                        escolher => { root.novo-imagem = o.path; }
                    }
                }
            }
            if novo-motor == 0 && novo-nota != "": Text { text: novo-nota; font-size: 11px; color: Tema.tinta; opacity: 0.75; wrap: word-wrap; }
            nome := Campo { dica: @tr("Name (e.g. Work-Account)"); }
            grupo := Campo { dica: @tr("Group (optional)"); }
            if novo-erro != "": Text { text: novo-erro; font-size: 12px; font-weight: 700; color: Tema.vermelho; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px; alignment: end;
                Botao { texto: @tr("Cancel"); clicou => { root.tela = ""; } }
                Botao {
                    texto: novo-ocupado ? @tr("Downloading…") : @tr("Create"); cor: Tema.azul; ativo: !novo-ocupado;
                    clicou => { root.criar(root.novo-motor, root.novo-tipo, root.novo-imagem, nome.texto, grupo.texto); }
                }
            }
        }
    }

    if tela == "menu": Sobreposta {
        largura: 360px; altura: 270px;
        fechar => { root.tela = ""; }
        VerticalLayout {
            padding: 20px; spacing: 10px; alignment: start;
            Text { text: alvo; font-size: 20px; font-weight: 900; color: Tema.tinta; overflow: elide; }
            Botao { texto: @tr("Duplicate"); clicou => { root.tela = ""; root.acao(root.alvo, "duplicar"); } }
            Botao { texto: @tr("Group…"); clicou => { root.tela = "grupo"; } }
            Botao { texto: @tr("Delete…"); cor: Tema.vermelho; clicou => { root.tela = "apagar"; } }
            Botao { texto: @tr("Cancel"); clicou => { root.tela = ""; } }
        }
    }

    if tela == "grupo": Sobreposta {
        largura: 400px; altura: 230px;
        fechar => { root.tela = ""; }
        VerticalLayout {
            padding: 20px; spacing: 12px; alignment: start;
            Text { text: @tr("Group for {}", alvo); font-size: 18px; font-weight: 900; color: Tema.tinta; overflow: elide; }
            g := Campo { dica: @tr("Group name (empty removes the group)"); }
            HorizontalLayout {
                spacing: 10px; alignment: end;
                Botao { texto: @tr("Cancel"); clicou => { root.tela = ""; } }
                Botao { texto: @tr("Save"); cor: Tema.azul; clicou => { root.tela = ""; root.grupo(root.alvo, g.texto); } }
            }
        }
    }

    if tela == "apagar": Sobreposta {
        largura: 440px; altura: 200px;
        fechar => { root.tela = ""; }
        VerticalLayout {
            padding: 20px; spacing: 12px; alignment: start;
            Text { text: @tr("Delete {}?", alvo); font-size: 18px; font-weight: 900; color: Tema.tinta; overflow: elide; }
            Text { text: @tr("The device and everything on it (accounts, apps, photos) will be removed from this computer."); font-size: 13px; color: Tema.tinta; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px; alignment: end;
                Botao { texto: @tr("Cancel"); clicou => { root.tela = ""; } }
                Botao { texto: @tr("Delete"); cor: Tema.vermelho; clicou => { root.tela = ""; root.apagar(root.alvo); } }
            }
        }
    }
}
